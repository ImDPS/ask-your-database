# Copy to .env and fill in. Never commit .env.

# Read-only role used by the app (SELECT on the app schema views only)
DATABASE_URL_READONLY=postgres://app_readonly:change-me@localhost:5432/chinook

# Owner role, used only by the data-load script, never by the server
DATABASE_URL_OWNER=postgres://postgres:change-me@localhost:5432/chinook

# LLM provider: gemini (default) or fake (tests and offline demo)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Cost guards
DAILY_LLM_CAP=200
RATE_LIMIT_PER_MINUTE=5

PORT=8080
